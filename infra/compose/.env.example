# Copy to .env (git-ignored): `cp .env.example .env`. Docker Compose loads .env from this folder automatically.
# Local development only. Replace every CHANGE_ME with your own value before the first `up`
# (for example: openssl rand -hex 16). Never reuse a real password, and never commit .env.
# Note: Postgres and RabbitMQ read their password only when their volume is first created;
# changing it later needs `docker compose down -v` (this deletes the local data).

POSTGRES_USER=paypulse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=paypulse

RABBITMQ_DEFAULT_USER=paypulse
RABBITMQ_DEFAULT_PASS=CHANGE_ME

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
